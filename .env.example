# Template for the secrets the council needs at runtime.
#
#   cp .env.example .env      then paste your real keys into .env
#
# `.env` is gitignored, and .claude/settings.json denies the assistant Read and
# Edit access to it — so the file with the real keys is yours alone.  This
# template is committed, which is why it must never contain a real key.
#
# The *names* below are what config.yaml refers to via `api_key_env`; the
# backend does os.environ[<that name>] at call time.  Adding a provider to
# config.yaml therefore means adding its variable here too.

OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me
